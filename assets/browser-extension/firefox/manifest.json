{
  "manifest_version": 3,
  "name": "TwitchTune · Заказы Twitch",
  "version": "1.1.8",
  "description": "Подтверждение конкретного заказа после прослушивания и оценки в TwitchTune.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.twitch.tv/popout/*/reward-queue*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/popout/*/reward-queue*"
      ],
      "js": [
        "matcher.js",
        "content.js"
      ]
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "twitchtune-queue@swerxxx",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}